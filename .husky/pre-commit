# Stop if another process changes the staged files while checks run.
pnpm exec lint-staged
tree_before=$(git write-tree)

pnpm typecheck

# Unit tests live only in src/ and test/runner/, so only those files can have related tests.
# Passing every staged file also overflows the Windows command line on large commits.
staged_ts=$(git diff --cached --name-only --diff-filter=ACMR -- 'src/*.ts' 'test/runner/*.ts')
if [ -n "$staged_ts" ]; then
  pnpm exec vitest related --run --passWithNoTests $staged_ts
fi

tree_after=$(git write-tree)
if [ "$tree_before" != "$tree_after" ]; then
  echo "Staged files changed while checks were running. Review the stage and commit again." >&2
  exit 1
fi
