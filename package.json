{
  "name": "journey-a11y",
  "version": "0.0.0",
  "description": "Re-run your Playwright E2E tests keyboard-only and record what the user experiences on each step.",
  "keywords": [
    "playwright",
    "accessibility",
    "a11y",
    "keyboard",
    "e2e"
  ],
  "homepage": "https://github.com/SeoJaeWan/a11y#readme",
  "bugs": "https://github.com/SeoJaeWan/a11y/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeoJaeWan/a11y.git"
  },
  "license": "MIT",
  "author": "SeoJaeWan",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.54 <2"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsdown": "0.23.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "validate-branch-name": "^1.3.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  }
}
